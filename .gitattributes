# Preserve official source files with Git LFS.
data/shugiin*/raw/*.pdf filter=lfs diff=lfs merge=lfs -text
data/shugiin*/raw/*.xls filter=lfs diff=lfs merge=lfs -text
data/shugiin*/raw/*.xlsx filter=lfs diff=lfs merge=lfs -text

# Keep project text consistently encoded and checked out.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

